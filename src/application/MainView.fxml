<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="[http://javafx.com/fxml](http://javafx.com/fxml)" fx:controller="application.Controller">
    <top>
        <VBox spacing="10" style="-fx-padding: 10;">
            <Label text="Convertisseur XML ⇄ JSON" textFill="#2c3e50">
                <font><Font name="System Bold" size="18.0"/></font>
            </Label>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Choisir l'action :"/>
                <ComboBox fx:id="modeSelector" prefWidth="250.0" promptText="Sélectionnez une conversion"/>
                <Button text="CONVERTIR" onAction="#handleConvert" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                <Button text="Effacer" onAction="#handleClear"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.5" style="-fx-padding: 10;">
            <VBox spacing="5">
                <Label text="Entrée (Source)" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="inputText" wrapText="true" VBox.vgrow="ALWAYS" promptText="Collez votre XML ou JSON ici..."/>
            </VBox>
            <VBox spacing="5">
                <Label text="Sortie (Résultat)" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="outputText" wrapText="true" editable="false" VBox.vgrow="ALWAYS"/>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>